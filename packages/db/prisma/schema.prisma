model User {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String       @db.VarChar(160)
  email         String       @unique @db.VarChar(320)
  emailVerified Boolean      @default(false) @map("email_verified")
  image         String?      @db.Text
  platformRole  PlatformRole @default(USER) @map("platform_role")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  accounts             Account[]
  sessions             Session[]
  memberships          OrganizationMembership[]
  createdOrganizations Organization[]             @relation("OrganizationCreator")
  invitationsSent      OrganizationInvitation[]   @relation("InvitationSender")
  supportAccesses      PlatformSupportAccess[]
  auditEvents          AuditEvent[]
  consentsRecorded     Consent[]                  @relation("ConsentActor")
  messagesCreated      Message[]                  @relation("MessageCreator")
  appointmentRecords   AppointmentRecord[]        @relation("AppointmentRecordAuthor")
  appointmentNotes     AppointmentNote[]          @relation("AppointmentNoteAuthor")
  appointmentHistory   AppointmentStatusHistory[] @relation("AppointmentStatusActor")
  slotOfferAttempts    SlotOfferAttempt[]         @relation("SlotOfferAttemptActor")
  knowledgeVersions    KnowledgeVersion[]         @relation("KnowledgeVersionCreator")
  aiConversations      AIConversation[]           @relation("AIConversationCreator")
  promptConfigurations PromptConfiguration[]      @relation("PromptConfigurationUpdater")
  copilotInsights      CopilotInsight[]           @relation("CopilotInsightActor")
  copilotFeedback      CopilotFeedback[]          @relation("CopilotFeedbackActor")
  analyticsSnapshots   AnalyticsSnapshot[]        @relation("AnalyticsSnapshotActor")
  gymPortalAccess      GymTraineePortalAccess?
  gymInvitationsSent   GymTraineeInvitation[]     @relation("GymTraineeInvitationSender")

  @@map("users")
}

model Session {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt             DateTime @map("expires_at") @db.Timestamptz(3)
  token                 String   @unique @db.VarChar(255)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  ipAddress             String?  @map("ip_address") @db.VarChar(64)
  userAgent             String?  @map("user_agent") @db.Text
  userId                String   @map("user_id") @db.Uuid
  activeOrganizationId  String?  @map("active_organization_id") @db.Uuid
  activeMembershipId    String?  @map("active_membership_id") @db.Uuid
  activeSupportAccessId String?  @map("active_support_access_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String    @map("account_id") @db.VarChar(255)
  providerId            String    @map("provider_id") @db.VarChar(100)
  issuer                String    @db.VarChar(255)
  userId                String    @map("user_id") @db.Uuid
  accessToken           String?   @map("access_token") @db.Text
  refreshToken          String?   @map("refresh_token") @db.Text
  idToken               String?   @map("id_token") @db.Text
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at") @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at") @db.Timestamptz(3)
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([issuer, accountId])
  @@index([userId])
  @@map("accounts")
}

model Verification {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String   @db.VarChar(320)
  value      String   @db.Text
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([identifier])
  @@map("verifications")
}

model RateLimit {
  id          String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String @unique @db.VarChar(255)
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

model Organization {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug             String             @unique @db.VarChar(80)
  nameEn           String             @map("name_en") @db.VarChar(160)
  nameAr           String             @map("name_ar") @db.VarChar(160)
  status           OrganizationStatus @default(PENDING)
  createdByUserId  String             @map("created_by_user_id") @db.Uuid
  suspendedAt      DateTime?          @map("suspended_at") @db.Timestamptz(3)
  suspensionReason String?            @map("suspension_reason") @db.VarChar(500)
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  createdBy                   User                          @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  settings                    OrganizationSettings?
  branches                    Branch[]
  memberships                 OrganizationMembership[]
  roles                       Role[]
  rolePermissions             RolePermission[]
  membershipRoles             MembershipRole[]
  staffProfiles               StaffProfile[]
  staffBranches               StaffBranchAssignment[]
  services                    Service[]
  serviceBranches             ServiceBranch[]
  staffServices               StaffService[]
  availabilityRules           AvailabilityRule[]
  timeOffEntries              TimeOff[]
  customers                   Customer[]
  customerContacts            CustomerContact[]
  consents                    Consent[]
  appointments                Appointment[]
  reservations                AppointmentStaffReservation[]
  branchHoursRules            BranchHoursRule[]
  resourceGroups              ResourceGroup[]
  resources                   Resource[]
  resourceAvailability        ResourceAvailabilityRule[]
  serviceResourceNeeds        ServiceResourceRequirement[]
  appointmentResources        AppointmentResource[]
  waitlistEntries             WaitlistEntry[]
  waitlistBranches            WaitlistEntryBranch[]
  waitlistProviders           WaitlistEntryProvider[]
  slotOffers                  SlotOffer[]
  slotOfferAttempts           SlotOfferAttempt[]
  appointmentRecords          AppointmentRecord[]
  appointmentHistory          AppointmentStatusHistory[]
  appointmentNotes            AppointmentNote[]
  appointmentParticipants     AppointmentParticipant[]
  appointmentIdempotencies    AppointmentIdempotency[]
  invitations                 OrganizationInvitation[]
  supportAccesses             PlatformSupportAccess[]
  auditEvents                 AuditEvent[]
  conversations               Conversation[]
  messages                    Message[]
  messageAttempts             MessageAttempt[]
  messageTemplates            MessageTemplate[]
  outboxEvents                OutboxEvent[]
  inboxEvents                 InboxEvent[]
  deliveryReceipts            DeliveryReceipt[]
  communicationPreferences    CommunicationPreference[]
  providerConnections         ProviderConnection[]
  knowledgeSources            KnowledgeSource[]
  knowledgeDocuments          KnowledgeDocument[]
  knowledgeChunks             KnowledgeChunk[]
  knowledgeVersions           KnowledgeVersion[]
  aiConversations             AIConversation[]
  aiMessages                  AIMessage[]
  aiActions                   AIAction[]
  aiActionApprovals           AIActionApproval[]
  aiUsage                     AIUsage[]
  humanHandoffs               HumanHandoff[]
  promptConfigurations        PromptConfiguration[]
  aiEvaluationCases           AIEvaluationCase[]
  aiEvaluationRuns            AIEvaluationRun[]
  websiteWidgetConfigurations WebsiteWidgetConfiguration[]
  aiChannelSessions           AIChannelSession[]
  aiChannelPendingActions     AIChannelPendingAction[]
  calls                       Call[]
  callEvents                  CallEvent[]
  callRecordings              CallRecording[]
  callTranscripts             CallTranscript[]
  callSummaries               CallSummary[]
  copilotInsights             CopilotInsight[]
  copilotInsightSources       CopilotInsightSource[]
  copilotFeedback             CopilotFeedback[]
  analyticsSnapshots          AnalyticsSnapshot[]
  predictiveSettings          PredictiveCapabilitySetting[]
  predictiveJobs              PredictiveJob[]
  predictiveDataAudits        PredictiveDataAudit[]
  predictiveFeatureSnapshots  PredictiveFeatureSnapshot[]
  predictiveModelVersions     PredictiveModelVersion[]
  predictions                 Prediction[]
  predictiveEvaluationRuns    PredictiveEvaluationRun[]
  predictiveDriftRuns         PredictiveDriftRun[]
  predictiveFeedback          PredictiveFeedback[]
  operationalCalendarEvents   OperationalCalendarEvent[]
  gymTraineeProfiles          GymTraineeProfile[]
  gymWorkoutPlans             GymWorkoutPlan[]
  gymWorkoutExercises         GymWorkoutExercise[]
  gymWorkoutLogs              GymWorkoutLog[]
  gymNutritionPlans           GymNutritionPlan[]
  gymNutritionMeals           GymNutritionMeal[]
  gymProgressEntries          GymProgressEntry[]
  gymTraineePortalAccesses    GymTraineePortalAccess[]
  gymTraineeInvitations       GymTraineeInvitation[]

  @@map("organizations")
}

model OrganizationSettings {
  id                String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String          @unique @map("organization_id") @db.Uuid
  defaultLocale     SupportedLocale @default(en) @map("default_locale")
  timezone          String          @default("Asia/Amman") @db.VarChar(100)
  currency          String          @default("JOD") @db.Char(3)
  bookingWindowDays Int             @default(60) @map("booking_window_days")
  businessSector    BusinessSector? @map("business_sector")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@map("organization_settings")
}

model Branch {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  nameEn         String   @map("name_en") @db.VarChar(160)
  nameAr         String   @map("name_ar") @db.VarChar(160)
  timezone       String   @default("Asia/Amman") @db.VarChar(100)
  phone          String?  @db.VarChar(40)
  addressEn      String?  @map("address_en") @db.VarChar(500)
  addressAr      String?  @map("address_ar") @db.VarChar(500)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  staffAssignments   StaffBranchAssignment[]
  serviceBranches    ServiceBranch[]
  availabilityRules  AvailabilityRule[]
  timeOffEntries     TimeOff[]
  appointments       Appointment[]
  hoursRules         BranchHoursRule[]
  resourceGroups     ResourceGroup[]
  resources          Resource[]
  resourceNeeds      ServiceResourceRequirement[]
  waitlistEntries    WaitlistEntryBranch[]
  slotOffers         SlotOffer[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@unique([organizationId, id])
  @@index([organizationId, isActive])
  @@map("branches")
}

model OrganizationMembership {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  status         MembershipStatus @default(ACTIVE)
  joinedAt       DateTime         @default(now()) @map("joined_at") @db.Timestamptz(3)
  suspendedAt    DateTime?        @map("suspended_at") @db.Timestamptz(3)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  roles              MembershipRole[]
  staffProfile       StaffProfile?
  assignedAIHandoffs HumanHandoff[]
  copilotInsights    CopilotInsight[]

  @@unique([organizationId, userId])
  @@unique([organizationId, id])
  @@index([userId, status])
  @@map("organization_memberships")
}

model Role {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  key            String         @db.VarChar(80)
  systemKey      TenantRoleKey? @map("system_key")
  nameEn         String         @map("name_en") @db.VarChar(120)
  nameAr         String         @map("name_ar") @db.VarChar(120)
  isSystem       Boolean        @default(false) @map("is_system")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  MembershipRole[]
  invitations  OrganizationInvitation[]

  @@unique([organizationId, id])
  @@unique([organizationId, key])
  @@unique([organizationId, systemKey])
  @@map("roles")
}

model Permission {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String   @unique @db.VarChar(120)
  nameEn      String   @map("name_en") @db.VarChar(160)
  nameAr      String   @map("name_ar") @db.VarChar(160)
  description String?  @db.VarChar(500)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  organizationId String          @map("organization_id") @db.Uuid
  roleId         String          @map("role_id") @db.Uuid
  permissionId   String          @map("permission_id") @db.Uuid
  scope          PermissionScope @default(ORGANIZATION)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)
  permission   Permission   @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([organizationId, roleId, permissionId])
  @@map("role_permissions")
}

model MembershipRole {
  organizationId String   @map("organization_id") @db.Uuid
  membershipId   String   @map("membership_id") @db.Uuid
  roleId         String   @map("role_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership   OrganizationMembership @relation(fields: [organizationId, membershipId], references: [organizationId, id], onDelete: Cascade)
  role         Role                   @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Cascade)

  @@id([organizationId, membershipId, roleId])
  @@map("membership_roles")
}

model StaffProfile {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  membershipId   String   @unique @map("membership_id") @db.Uuid
  displayNameEn  String   @map("display_name_en") @db.VarChar(160)
  displayNameAr  String   @map("display_name_ar") @db.VarChar(160)
  bioEn          String?  @map("bio_en") @db.Text
  bioAr          String?  @map("bio_ar") @db.Text
  isBookable     Boolean  @default(false) @map("is_bookable")
