  organizationId  String               @map("organization_id") @db.Uuid
  customerId      String               @map("customer_id") @db.Uuid
  channel         CommunicationChannel
  isEnabled       Boolean              @default(false) @map("is_enabled")
  changedByUserId String?              @map("changed_by_user_id") @db.Uuid
  reason          String?              @db.VarChar(500)
  version         Int                  @default(1)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer     @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, customerId, channel])
  @@index([organizationId, customerId])
  @@map("communication_preferences")
}

model Message {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  conversationId       String               @map("conversation_id") @db.Uuid
  customerId           String               @map("customer_id") @db.Uuid
  appointmentId        String?              @map("appointment_id") @db.Uuid
  templateId           String?              @map("template_id") @db.Uuid
  providerConnectionId String?              @map("provider_connection_id") @db.Uuid
  createdByUserId      String?              @map("created_by_user_id") @db.Uuid
  channel              CommunicationChannel
  direction            MessageDirection
  status               MessageStatus        @default(QUEUED)
  locale               SupportedLocale
  body                 String               @db.Text
  consentPurpose       String?              @map("consent_purpose") @db.VarChar(120)
  consentId            String?              @map("consent_id") @db.Uuid
  providerMessageId    String?              @map("provider_message_id") @db.VarChar(200)
  lastErrorCode        String?              @map("last_error_code") @db.VarChar(100)
  lastErrorCategory    String?              @map("last_error_category") @db.VarChar(80)
  sentAt               DateTime?            @map("sent_at") @db.Timestamptz(3)
  deliveredAt          DateTime?            @map("delivered_at") @db.Timestamptz(3)
  failedAt             DateTime?            @map("failed_at") @db.Timestamptz(3)
  version              Int                  @default(1)
  createdAt            DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation       Conversation        @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Restrict)
  customer           Customer            @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  appointment        Appointment?        @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict)
  template           MessageTemplate?    @relation(fields: [organizationId, templateId], references: [organizationId, id], onDelete: Restrict)
  providerConnection ProviderConnection? @relation(fields: [organizationId, providerConnectionId], references: [organizationId, id], onDelete: Restrict)
  createdBy          User?               @relation("MessageCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  attempts           MessageAttempt[]
  deliveryReceipts   DeliveryReceipt[]

  @@unique([organizationId, id])
  @@unique([organizationId, providerConnectionId, providerMessageId])
  @@index([organizationId, conversationId, createdAt])
  @@index([organizationId, customerId, createdAt])
  @@index([organizationId, appointmentId, createdAt])
  @@index([organizationId, status, createdAt])
  @@map("messages")
}

model MessageAttempt {
  id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String               @map("organization_id") @db.Uuid
  messageId            String               @map("message_id") @db.Uuid
  providerConnectionId String?              @map("provider_connection_id") @db.Uuid
  attemptNumber        Int                  @map("attempt_number")
  idempotencyKey       String               @map("idempotency_key") @db.VarChar(200)
  status               MessageAttemptStatus
  providerMessageId    String?              @map("provider_message_id") @db.VarChar(200)
  errorCode            String?              @map("error_code") @db.VarChar(100)
  errorCategory        String?              @map("error_category") @db.VarChar(80)
  safeErrorMessage     String?              @map("safe_error_message") @db.VarChar(300)
  startedAt            DateTime             @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt           DateTime?            @map("finished_at") @db.Timestamptz(3)
  durationMs           Int?                 @map("duration_ms")
  nextRetryAt          DateTime?            @map("next_retry_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message            Message             @relation(fields: [organizationId, messageId], references: [organizationId, id], onDelete: Restrict)
  providerConnection ProviderConnection? @relation(fields: [organizationId, providerConnectionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, messageId, attemptNumber])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, messageId, startedAt])
  @@map("message_attempts")
}

model OutboxEvent {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String            @map("organization_id") @db.Uuid
  eventType         String            @map("event_type") @db.VarChar(100)
  aggregateType     String            @map("aggregate_type") @db.VarChar(80)
  aggregateId       String            @map("aggregate_id") @db.Uuid
  aggregateVersion  Int               @map("aggregate_version")
  deduplicationKey  String            @map("deduplication_key") @db.VarChar(220)
  payload           Json
  status            OutboxEventStatus @default(PENDING)
  availableAt       DateTime          @default(now()) @map("available_at") @db.Timestamptz(3)
  claimedAt         DateTime?         @map("claimed_at") @db.Timestamptz(3)
  claimedBy         String?           @map("claimed_by") @db.VarChar(120)
  enqueuedAt        DateTime?         @map("enqueued_at") @db.Timestamptz(3)
  processedAt       DateTime?         @map("processed_at") @db.Timestamptz(3)
  deadLetterAt      DateTime?         @map("dead_letter_at") @db.Timestamptz(3)
  deliveryAttempts  Int               @default(0) @map("delivery_attempts")
  lastErrorCode     String?           @map("last_error_code") @db.VarChar(100)
  lastErrorCategory String?           @map("last_error_category") @db.VarChar(80)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, deduplicationKey])
  @@index([status, availableAt, createdAt])
  @@index([organizationId, aggregateType, aggregateId])
  @@map("outbox_events")
}

model InboxEvent {
  id                   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  providerConnectionId String           @map("provider_connection_id") @db.Uuid
  providerEventId      String           @map("provider_event_id") @db.VarChar(200)
  eventType            String           @map("event_type") @db.VarChar(100)
  payloadDigest        String           @map("payload_digest") @db.Char(64)
  payload              Json
  status               InboxEventStatus @default(RECEIVED)
  receivedAt           DateTime         @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt          DateTime?        @map("processed_at") @db.Timestamptz(3)
  errorCode            String?          @map("error_code") @db.VarChar(100)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  providerConnection ProviderConnection @relation(fields: [organizationId, providerConnectionId], references: [organizationId, id], onDelete: Restrict)
  deliveryReceipts   DeliveryReceipt[]

  @@unique([organizationId, id])
  @@unique([providerConnectionId, providerEventId])
  @@index([organizationId, status, receivedAt])
  @@map("inbox_events")
}

model DeliveryReceipt {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  messageId            String        @map("message_id") @db.Uuid
  providerConnectionId String        @map("provider_connection_id") @db.Uuid
  inboxEventId         String?       @map("inbox_event_id") @db.Uuid
  providerMessageId    String        @map("provider_message_id") @db.VarChar(200)
  state                DeliveryState
  providerTimestamp    DateTime      @map("provider_timestamp") @db.Timestamptz(3)
  normalizedErrorCode  String?       @map("normalized_error_code") @db.VarChar(100)
  receivedAt           DateTime      @default(now()) @map("received_at") @db.Timestamptz(3)

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  message            Message            @relation(fields: [organizationId, messageId], references: [organizationId, id], onDelete: Restrict)
  providerConnection ProviderConnection @relation(fields: [organizationId, providerConnectionId], references: [organizationId, id], onDelete: Restrict)
  inboxEvent         InboxEvent?        @relation(fields: [organizationId, inboxEventId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, inboxEventId])
  @@index([organizationId, messageId, providerTimestamp])
  @@map("delivery_receipts")
}

model WorkerHeartbeat {
  workerId           String    @id @map("worker_id") @db.VarChar(120)
  queueName          String    @map("queue_name") @db.VarChar(120)
  status             String    @db.VarChar(40)
  lastSeenAt         DateTime  @map("last_seen_at") @db.Timestamptz(3)
  processedCount     Int       @default(0) @map("processed_count")
  failedCount        Int       @default(0) @map("failed_count")
  lastProcessedAt    DateTime? @map("last_processed_at") @db.Timestamptz(3)
  applicationVersion String    @map("application_version") @db.VarChar(80)
  startedAt          DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([queueName, lastSeenAt])
  @@map("worker_heartbeats")
}

model KnowledgeSource {
  id               String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  name             String                   @db.VarChar(180)
  sourceType       KnowledgeSourceType      @map("source_type")
  originalFilename String?                  @map("original_filename") @db.VarChar(255)
  ingestionStatus  KnowledgeIngestionStatus @default(DRAFT) @map("ingestion_status")
  activeVersionId  String?                  @map("active_version_id") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  activeVersion KnowledgeVersion?   @relation("KnowledgeSourceActiveVersion", fields: [organizationId, activeVersionId], references: [organizationId, id], onDelete: Restrict)
  versions      KnowledgeVersion[]  @relation("KnowledgeSourceVersions")
  documents     KnowledgeDocument[]
  chunks        KnowledgeChunk[]

  @@unique([organizationId, id])
  @@index([organizationId, ingestionStatus, updatedAt])
  @@map("knowledge_sources")
}

model KnowledgeVersion {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  sourceId        String                 @map("source_id") @db.Uuid
  versionNumber   Int                    @map("version_number")
  status          KnowledgeVersionStatus @default(DRAFT)
  checksum        String                 @db.Char(64)
  createdByUserId String?                @map("created_by_user_id") @db.Uuid
  activatedAt     DateTime?              @map("activated_at") @db.Timestamptz(3)
  rolledBackAt    DateTime?              @map("rolled_back_at") @db.Timestamptz(3)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  organization     Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source           KnowledgeSource     @relation("KnowledgeSourceVersions", fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  activeForSources KnowledgeSource[]   @relation("KnowledgeSourceActiveVersion")
  createdBy        User?               @relation("KnowledgeVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  documents        KnowledgeDocument[]
  chunks           KnowledgeChunk[]

  @@unique([organizationId, id])
  @@unique([organizationId, sourceId, versionNumber])
  @@index([organizationId, status, activatedAt])
  @@map("knowledge_versions")
}

model KnowledgeDocument {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  sourceId       String            @map("source_id") @db.Uuid
  versionId      String            @map("version_id") @db.Uuid
  title          String            @db.VarChar(220)
  language       KnowledgeLanguage @default(mixed)
  checksum       String            @db.Char(64)
  content        String            @db.Text
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       KnowledgeSource  @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  version      KnowledgeVersion @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Cascade)
  chunks       KnowledgeChunk[]

  @@unique([organizationId, id])
  @@index([organizationId, sourceId, versionId])
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id             String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String            @map("organization_id") @db.Uuid
  sourceId       String            @map("source_id") @db.Uuid
  documentId     String            @map("document_id") @db.Uuid
  versionId      String            @map("version_id") @db.Uuid
  position       Int
  language       KnowledgeLanguage @default(mixed)
  content        String            @db.Text
  checksum       String            @db.Char(64)
  isQuarantined  Boolean           @default(false) @map("is_quarantined")
  safetyReason   String?           @map("safety_reason") @db.VarChar(120)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source       KnowledgeSource   @relation(fields: [organizationId, sourceId], references: [organizationId, id], onDelete: Cascade)
  document     KnowledgeDocument @relation(fields: [organizationId, documentId], references: [organizationId, id], onDelete: Cascade)
  version      KnowledgeVersion  @relation(fields: [organizationId, versionId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@unique([organizationId, documentId, position])
  @@index([organizationId, versionId, isQuarantined])
  @@map("knowledge_chunks")
}

model PromptConfiguration {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String   @map("organization_id") @db.Uuid
  name                   String   @db.VarChar(120)
  systemPrompt           String   @map("system_prompt") @db.Text
  allowedActionNames     String[] @map("allowed_action_names")
  minimumConfidence      Float    @default(0.7) @map("minimum_confidence")
  monthlyActionLimit     Int      @default(1000) @map("monthly_action_limit")
  monthlyTokenLimit      Int      @default(1000000) @map("monthly_token_limit")
  monthlyCostLimitMicros Int      @default(25000000) @map("monthly_cost_limit_micros")
  isActive               Boolean  @default(true) @map("is_active")
  version                Int      @default(1)
  updatedByUserId        String?  @map("updated_by_user_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedBy       User?             @relation("PromptConfigurationUpdater", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  conversations   AIConversation[]
  usage           AIUsage[]
  evaluationRuns  AIEvaluationRun[]
  copilotInsights CopilotInsight[]

  @@unique([organizationId, id])
  @@index([organizationId, isActive, updatedAt])
  @@map("prompt_configurations")
}

model AIConversation {
  id                    String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String               @map("organization_id") @db.Uuid
  customerId            String?              @map("customer_id") @db.Uuid
  appointmentId         String?              @map("appointment_id") @db.Uuid
  promptConfigurationId String?              @map("prompt_configuration_id") @db.Uuid
  createdByUserId       String?              @map("created_by_user_id") @db.Uuid
  locale                KnowledgeLanguage    @default(mixed)
  channel               String               @default("INTERNAL") @db.VarChar(40)
  status                AIConversationStatus @default(OPEN)
  modelIdentifier       String               @map("model_identifier") @db.VarChar(160)
  lastMessageAt         DateTime?            @map("last_message_at") @db.Timestamptz(3)
  version               Int                  @default(1)
  createdAt             DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer            Customer?            @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  appointment         Appointment?         @relation(fields: [organizationId, appointmentId], references: [organizationId, id], onDelete: Restrict)
  promptConfiguration PromptConfiguration? @relation(fields: [organizationId, promptConfigurationId], references: [organizationId, id], onDelete: Restrict)
  createdBy           User?                @relation("AIConversationCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  messages            AIMessage[]
  actions             AIAction[]
  approvals           AIActionApproval[]
  usage               AIUsage[]
  handoffs            HumanHandoff[]
  channelSession      AIChannelSession?

  @@unique([organizationId, id])
  @@index([organizationId, status, lastMessageAt])
  @@index([organizationId, customerId, lastMessageAt])
  @@map("ai_conversations")
}

model AIMessage {
  id              String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                @map("organization_id") @db.Uuid
  conversationId  String                @map("conversation_id") @db.Uuid
  role            AIMessageRole
  content         String                @db.Text
  safetyStatus    AIMessageSafetyStatus @default(SAFE) @map("safety_status")
  modelIdentifier String?               @map("model_identifier") @db.VarChar(160)
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation AIConversation @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, conversationId, createdAt])
  @@map("ai_messages")
}

model AIAction {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId          String          @map("organization_id") @db.Uuid
  conversationId          String          @map("conversation_id") @db.Uuid
  requestId               String          @map("request_id") @db.Uuid
  actionName              String          @map("action_name") @db.VarChar(100)
  requiredPermission      String          @map("required_permission") @db.VarChar(120)
  authorizationDecisionId String          @map("authorization_decision_id") @db.Uuid
  actorId                 String          @map("actor_id") @db.Uuid
  actorType               String          @map("actor_type") @db.VarChar(40)
  channel                 String          @db.VarChar(40)
  idempotencyKey          String          @map("idempotency_key") @db.VarChar(200)
  inputFingerprint        String          @map("input_fingerprint") @db.Char(64)
  rawInput                Json            @map("raw_input")
  validatedInput          Json            @map("validated_input")
  result                  Json?
  latencyMs               Int?            @map("latency_ms")
  modelIdentifier         String          @map("model_identifier") @db.VarChar(160)
  outcome                 AIActionOutcome @default(PENDING)
  errorCode               String?         @map("error_code") @db.VarChar(100)
  auditEventId            String?         @map("audit_event_id") @db.Uuid
  createdAt               DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  completedAt             DateTime?       @map("completed_at") @db.Timestamptz(3)

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation         AIConversation          @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Restrict)
  approval             AIActionApproval?
  usage                AIUsage[]
  pendingChannelAction AIChannelPendingAction?

  @@unique([organizationId, id])
  @@unique([organizationId, requestId])
  @@unique([organizationId, actionName, idempotencyKey])
  @@index([organizationId, outcome, createdAt])
  @@index([organizationId, conversationId, createdAt])
  @@map("ai_actions")
}

model AIActionApproval {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  conversationId String                 @map("conversation_id") @db.Uuid
  actionId       String                 @unique @map("action_id") @db.Uuid
  customerId     String                 @map("customer_id") @db.Uuid
  actionName     String                 @map("action_name") @db.VarChar(100)
  summary        String                 @db.VarChar(1000)
  summaryHash    String                 @map("summary_hash") @db.Char(64)
  payloadHash    String                 @map("payload_hash") @db.Char(64)
  status         AIActionApprovalStatus @default(PENDING)
  expiresAt      DateTime               @map("expires_at") @db.Timestamptz(3)
  confirmedAt    DateTime?              @map("confirmed_at") @db.Timestamptz(3)
  consumedAt     DateTime?              @map("consumed_at") @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  organization         Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  conversation         AIConversation          @relation(fields: [organizationId, conversationId], references: [organizationId, id], onDelete: Restrict)
  action               AIAction                @relation(fields: [organizationId, actionId], references: [organizationId, id], onDelete: Restrict)
  customer             Customer                @relation(fields: [organizationId, customerId], references: [organizationId, id], onDelete: Restrict)
  pendingChannelAction AIChannelPendingAction?

  @@unique([organizationId, id])
  @@unique([organizationId, actionId])
  @@index([organizationId, status, expiresAt])
  @@map("ai_action_approvals")
}

model AIUsage {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String         @map("organization_id") @db.Uuid
  conversationId        String?        @map("conversation_id") @db.Uuid
  actionId              String?        @map("action_id") @db.Uuid
  promptConfigurationId String?        @map("prompt_configuration_id") @db.Uuid
  modelIdentifier       String         @map("model_identifier") @db.VarChar(160)
