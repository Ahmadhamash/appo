model PredictiveCapabilitySetting {
  organizationId  String               @map("organization_id") @db.Uuid
  capability      PredictiveCapability
  enabled         Boolean              @default(false)
  version         Int                  @default(1)
  updatedByUserId String               @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, capability])
  @@index([organizationId, enabled])
  @@map("predictive_capability_settings")
}

model PredictiveJob {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String               @map("organization_id") @db.Uuid
  actorUserId        String               @map("actor_user_id") @db.Uuid
  membershipId       String?              @map("membership_id") @db.Uuid
  supportAccessId    String?              @map("support_access_id") @db.Uuid
  capability         PredictiveCapability
  jobType            PredictiveJobType    @map("job_type")
  status             PredictiveJobStatus  @default(PENDING)
  idempotencyKey     String               @map("idempotency_key") @db.VarChar(160)
  requestFingerprint String               @map("request_fingerprint") @db.Char(64)
  branchId           String?              @map("branch_id") @db.Uuid
  appointmentId      String?              @map("appointment_id") @db.Uuid
  serviceId          String?              @map("service_id") @db.Uuid
  parameters         Json
  totalRows          Int                  @default(0) @map("total_rows")
  processedRows      Int                  @default(0) @map("processed_rows")
  attempts           Int                  @default(0)
  maxAttempts        Int                  @default(4) @map("max_attempts")
  claimedAt          DateTime?            @map("claimed_at") @db.Timestamptz(3)
  claimedBy          String?              @map("claimed_by") @db.VarChar(120)
  leaseToken         String?              @map("lease_token") @db.Uuid
  enqueuedAt         DateTime?            @map("enqueued_at") @db.Timestamptz(3)
  evaluationAt       DateTime?            @map("evaluation_at") @db.Timestamptz(3)
  startedAt          DateTime?            @map("started_at") @db.Timestamptz(3)
  completedAt        DateTime?            @map("completed_at") @db.Timestamptz(3)
  safeErrorCode      String?              @map("safe_error_code") @db.VarChar(100)
  createdAt          DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  dataAudits       PredictiveDataAudit[]
  featureSnapshots PredictiveFeatureSnapshot[]
  predictions      Prediction[]
  evaluations      PredictiveEvaluationRun[]
  driftRuns        PredictiveDriftRun[]

  @@unique([organizationId, id])
  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([organizationId, capability, createdAt])
  @@index([organizationId, branchId, createdAt])
  @@map("predictive_jobs")
}

model PredictiveDataAudit {
  id              String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  jobId           String                   @map("job_id") @db.Uuid
  capability      PredictiveCapability
  branchId        String?                  @map("branch_id") @db.Uuid
  eligible        Boolean
  refusalReason   PredictiveRefusalReason? @map("refusal_reason")
  sampleSize      Int                      @map("sample_size")
  historyStartsAt DateTime?                @map("history_starts_at") @db.Timestamptz(3)
  historyEndsAt   DateTime?                @map("history_ends_at") @db.Timestamptz(3)
  counts          Json
  warnings        String[]
  dataWatermark   DateTime                 @map("data_watermark") @db.Timestamptz(3)
  auditChecksum   String                   @map("audit_checksum") @db.Char(64)
  createdAt       DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          PredictiveJob @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, jobId])
  @@index([organizationId, capability, createdAt])
  @@map("predictive_data_audits")
}

model PredictiveFeatureSnapshot {
  id              String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String               @map("organization_id") @db.Uuid
  jobId           String               @map("job_id") @db.Uuid
  capability      PredictiveCapability
  subjectType     String               @map("subject_type") @db.VarChar(40)
  subjectId       String?              @map("subject_id") @db.Uuid
  asOf            DateTime             @map("as_of") @db.Timestamptz(3)
  features        Json
  featureHash     String               @map("feature_hash") @db.Char(64)
  sourceWatermark DateTime             @map("source_watermark") @db.Timestamptz(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          PredictiveJob @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  predictions  Prediction[]

  @@unique([organizationId, id])
  @@unique([organizationId, featureHash])
  @@index([organizationId, capability, subjectType, subjectId, asOf])
  @@map("predictive_feature_snapshots")
}

model PredictiveModelVersion {
  id                       String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String               @map("organization_id") @db.Uuid
  capability               PredictiveCapability
  algorithmIdentifier      String               @map("algorithm_identifier") @db.VarChar(160)
  version                  Int
  featureDefinitionVersion Int                  @map("feature_definition_version")
  labelDefinitionVersion   Int                  @map("label_definition_version")
  trainingStartsAt         DateTime?            @map("training_starts_at") @db.Timestamptz(3)
  trainingEndsAt           DateTime?            @map("training_ends_at") @db.Timestamptz(3)
  dataWatermark            DateTime             @map("data_watermark") @db.Timestamptz(3)
  parameters               Json
  sampleSize               Int                  @map("sample_size")
  checksum                 String               @db.Char(64)
  isActive                 Boolean              @default(false) @map("is_active")
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  predictions  Prediction[]
  evaluations  PredictiveEvaluationRun[]
  driftRuns    PredictiveDriftRun[]

  @@unique([organizationId, id])
  @@unique([organizationId, capability, version])
  @@unique([organizationId, checksum])
  @@index([organizationId, capability, isActive])
  @@map("predictive_model_versions")
}

model Prediction {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String                     @map("organization_id") @db.Uuid
  jobId             String?                    @map("job_id") @db.Uuid
  modelVersionId    String?                    @map("model_version_id") @db.Uuid
  featureSnapshotId String?                    @map("feature_snapshot_id") @db.Uuid
  capability        PredictiveCapability
  status            PredictivePredictionStatus
  branchId          String?                    @map("branch_id") @db.Uuid
  providerId        String?                    @map("provider_id") @db.Uuid
  serviceId         String?                    @map("service_id") @db.Uuid
  subjectType       String                     @map("subject_type") @db.VarChar(40)
  subjectId         String?                    @map("subject_id") @db.Uuid
  estimate          Float?
  lowerBound        Float?                     @map("lower_bound")
  upperBound        Float?                     @map("upper_bound")
  refusalReason     PredictiveRefusalReason?   @map("refusal_reason")
  sampleSize        Int                        @map("sample_size")
  modelIdentifier   String                     @map("model_identifier") @db.VarChar(160)
  modelVersion      Int                        @map("model_version")
  explanation       Json
  details           Json
  asOf              DateTime                   @map("as_of") @db.Timestamptz(3)
  horizonStartsAt   DateTime?                  @map("horizon_starts_at") @db.Timestamptz(3)
  horizonEndsAt     DateTime?                  @map("horizon_ends_at") @db.Timestamptz(3)
  expiresAt         DateTime                   @map("expires_at") @db.Timestamptz(3)
  generationKey     String                     @map("generation_key") @db.Char(64)
  createdAt         DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job             PredictiveJob?             @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  modelDefinition PredictiveModelVersion?    @relation(fields: [organizationId, modelVersionId], references: [organizationId, id], onDelete: Restrict)
  featureSnapshot PredictiveFeatureSnapshot? @relation(fields: [organizationId, featureSnapshotId], references: [organizationId, id], onDelete: Restrict)
  feedback        PredictiveFeedback[]

  @@unique([organizationId, id])
  @@unique([organizationId, generationKey])
  @@index([organizationId, capability, createdAt])
  @@index([organizationId, branchId, createdAt])
  @@index([organizationId, providerId, createdAt])
  @@index([organizationId, subjectType, subjectId, createdAt])
  @@map("predictions")
}

model PredictiveEvaluationRun {
  id             String                      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                      @map("organization_id") @db.Uuid
  jobId          String                      @map("job_id") @db.Uuid
  modelVersionId String?                     @map("model_version_id") @db.Uuid
  capability     PredictiveCapability
  runType        PredictiveEvaluationType    @map("run_type")
  outcome        PredictiveEvaluationOutcome
  branchId       String?                     @map("branch_id") @db.Uuid
  sampleSize     Int                         @map("sample_size")
  startsAt       DateTime?                   @map("starts_at") @db.Timestamptz(3)
  endsAt         DateTime?                   @map("ends_at") @db.Timestamptz(3)
  metrics        Json
  dataWatermark  DateTime                    @map("data_watermark") @db.Timestamptz(3)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          PredictiveJob           @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  modelVersion PredictiveModelVersion? @relation(fields: [organizationId, modelVersionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, jobId])
  @@index([organizationId, capability, createdAt])
  @@map("predictive_evaluation_runs")
}

model PredictiveDriftRun {
  id               String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                @map("organization_id") @db.Uuid
  jobId            String                @map("job_id") @db.Uuid
  modelVersionId   String?               @map("model_version_id") @db.Uuid
  capability       PredictiveCapability
  branchId         String?               @map("branch_id") @db.Uuid
  status           PredictiveDriftStatus
  score            Float?
  sampleSize       Int                   @map("sample_size")
  baselineStartsAt DateTime?             @map("baseline_starts_at") @db.Timestamptz(3)
  baselineEndsAt   DateTime?             @map("baseline_ends_at") @db.Timestamptz(3)
  currentStartsAt  DateTime?             @map("current_starts_at") @db.Timestamptz(3)
  currentEndsAt    DateTime?             @map("current_ends_at") @db.Timestamptz(3)
  metrics          Json
  dataWatermark    DateTime              @map("data_watermark") @db.Timestamptz(3)
  createdAt        DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  job          PredictiveJob           @relation(fields: [organizationId, jobId], references: [organizationId, id], onDelete: Restrict)
  modelVersion PredictiveModelVersion? @relation(fields: [organizationId, modelVersionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@unique([organizationId, jobId])
  @@index([organizationId, capability, createdAt])
  @@map("predictive_drift_runs")
}

model PredictiveFeedback {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String                 @map("organization_id") @db.Uuid
  predictionId   String                 @map("prediction_id") @db.Uuid
  actorUserId    String                 @map("actor_user_id") @db.Uuid
  feedbackType   PredictiveFeedbackType @map("feedback_type")
  comment        String?                @db.VarChar(500)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  prediction   Prediction   @relation(fields: [organizationId, predictionId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, predictionId, createdAt])
  @@map("predictive_feedback")
}

model OperationalCalendarEvent {
  id               String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String                       @map("organization_id") @db.Uuid
  branchId         String?                      @map("branch_id") @db.Uuid
  eventType        OperationalCalendarEventType @map("event_type")
  localDate        DateTime                     @map("local_date") @db.Date
  labelEn          String                       @map("label_en") @db.VarChar(160)
  labelAr          String                       @map("label_ar") @db.VarChar(160)
  demandAdjustment Float?                       @map("demand_adjustment")
  version          Int                          @default(1)
  isActive         Boolean                      @default(true) @map("is_active")
  createdByUserId  String                       @map("created_by_user_id") @db.Uuid
  createdAt        DateTime                     @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, id])
  @@index([organizationId, branchId, localDate, isActive])
  @@map("operational_calendar_events")
}

model AIEvaluationRun {
  id                    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  evaluationCaseId      String              @map("evaluation_case_id") @db.Uuid
  promptConfigurationId String?             @map("prompt_configuration_id") @db.Uuid
  modelIdentifier       String              @map("model_identifier") @db.VarChar(160)
  outcome               AIEvaluationOutcome
  actualAction          String?             @map("actual_action") @db.VarChar(100)
  responseExcerpt       String?             @map("response_excerpt") @db.VarChar(500)
  latencyMs             Int                 @map("latency_ms")
  safeTrace             Json?               @map("safe_trace")
  createdAt             DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evaluationCase      AIEvaluationCase     @relation(fields: [organizationId, evaluationCaseId], references: [organizationId, id], onDelete: Cascade)
  promptConfiguration PromptConfiguration? @relation(fields: [organizationId, promptConfigurationId], references: [organizationId, id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, evaluationCaseId, createdAt])
  @@map("ai_evaluation_runs")
}

model OrganizationInvitation {
  id               String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  email            String           @db.VarChar(320)
  tokenHash        String           @unique @map("token_hash") @db.Char(64)
  roleId           String           @map("role_id") @db.Uuid
  status           InvitationStatus @default(PENDING)
  invitedByUserId  String           @map("invited_by_user_id") @db.Uuid
  expiresAt        DateTime         @map("expires_at") @db.Timestamptz(3)
  acceptedAt       DateTime?        @map("accepted_at") @db.Timestamptz(3)
  acceptedByUserId String?          @map("accepted_by_user_id") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  role         Role         @relation(fields: [organizationId, roleId], references: [organizationId, id], onDelete: Restrict)
  invitedBy    User         @relation("InvitationSender", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([organizationId, email, status])
  @@map("organization_invitations")
}

model PlatformSupportAccess {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  reason          String    @db.VarChar(500)
  permissionCodes String[]  @map("permission_codes")
  startsAt        DateTime  @default(now()) @map("starts_at") @db.Timestamptz(3)
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, id])
  @@index([userId, organizationId, expiresAt])
  @@map("platform_support_accesses")
}

model AuditEvent {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  actorUserId     String?  @map("actor_user_id") @db.Uuid
  supportAccessId String?  @map("support_access_id") @db.Uuid
  action          String   @db.VarChar(120)
  targetType      String?  @map("target_type") @db.VarChar(100)
  targetId        String?  @map("target_id") @db.Uuid
  reason          String?  @db.VarChar(500)
  metadata        Json?
  ipAddress       String?  @map("ip_address") @db.VarChar(64)
  userAgent       String?  @map("user_agent") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  actor        User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@unique([organizationId, id])
  @@index([organizationId, createdAt])
  @@index([supportAccessId, createdAt])
  @@map("audit_events")
}
