# Copy this file to .env, then replace every replace-* value before starting services.
# This file contains placeholders only and is safe to commit. Never commit .env.

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
OTEL_SERVICE_NAME=jormall-platform

POSTGRES_DB=jormall
POSTGRES_USER=jormall_local
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jormall_local:replace-with-a-local-postgres-password@localhost:5432/jormall

REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_PORT=6379
REDIS_URL=redis://:replace-with-a-local-redis-password@localhost:6379/0
# Local/mock WhatsApp HMAC only; never reuse a production provider secret.
MOCK_WHATSAPP_WEBHOOK_SECRET=replace-with-a-local-mock-webhook-secret
# Local/mock voice webhook HMAC only; never reuse a production provider secret.
MOCK_VOICE_WEBHOOK_SECRET=replace-with-a-local-mock-voice-webhook-secret
# Signs public widget installation/session capabilities; it is never sent to the browser.
WIDGET_SIGNING_SECRET=replace-with-a-local-widget-signing-secret

AUTH_SECRET=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-32-byte-base64-encoded-key

# Optional and development-only. Set locally before running pnpm db:seed.
DEV_SEED_PASSWORD=replace-with-a-development-only-password
